{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/assets/jeffresume(.*)",
      "destination": "/documents/jefrine-correya-resume.pdf"
    },
    {
      "source": "/media/astra-hero.mp4",
      "destination": "/media/cybersecurity-native-glass-1080p60.mp4"
    },
    {
      "source": "/media/cybersecurity-hero-loop.mp4",
      "destination": "/media/cybersecurity-native-glass-1080p60.mp4"
    },
    {
      "source": "/images/cybersecurity-liquid-glass-poster.webp",
      "destination": "/images/cybersecurity-native-glass-poster.webp"
    },
    {
      "source": "/images/cybersecurity-liquid-glass-mobile.webp",
      "destination": "/images/cybersecurity-native-glass-mobile.webp"
    },
    {
      "source": "/media/cybersecurity-liquid-glass-loop.mp4",
      "destination": "/media/cybersecurity-native-glass-1080p60.mp4"
    },
    {
      "source": "/media/cybersecurity-liquid-glass.provenance.json",
      "destination": "/media/cybersecurity-native-glass.provenance.json"
    },
    {
      "source": "/((?!media/|images/|fonts/|documents/|assets/|.well-known/|favicon.svg|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/documents/jefrine-correya-resume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Jefrine-Correya-Resume.pdf\""
        }
      ]
    },
    {
      "source": "/documents/jefrine-cicsa-certificate.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Jefrine-Correya-CICSA-Certificate.pdf\""
        }
      ]
    },
    {
      "source": "/documents/jefrine-ec-council-csa-certificate.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Jefrine-Correya-EC-Council-CSA-Certificate.pdf\""
        }
      ]
    },
    {
      "source": "/documents/jefrine-experience-certificate.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Jefrine-Correya-Experience-Certificate.pdf\""
        }
      ]
    },
    {
      "source": "/assets/jeffresume(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Jefrine-Correya-Resume.pdf\""
        }
      ]
    }
  ]
}
